<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/sidebar') %>

<div class="cers-card">
  <div class="cers-card-title" style="border-bottom: 1px solid var(--cers-border); padding-bottom: 0.75rem; margin-bottom: 1.15rem;">
    File Campus Emergency Report
  </div>
  <p class="text-muted" style="font-size: 0.78rem; margin-bottom: 1.25rem;">
    Submit verified incident details to immediately alert designated response units. Browser GPS coordinates auto-lock on form initialization.
  </p>

  <form id="cers-report-form">
    <div class="cers-form-group">
      <label for="category" class="cers-form-label">Incident Category</label>
      <select id="category" class="cers-form-control" required>
        <option value="" disabled selected>-- Select Incident Category --</option>
        <option value="security">Security Alert / Theft / Trespass / Assault</option>
        <option value="medical">Medical Emergency / Injury / Collapse</option>
        <option value="fire">Fire Hazard / Smoke / Electrical / Gas Leak</option>
        <option value="accident">Accident / Vehicle Collision / Slip & Fall</option>
        <option value="other">Other Campus Danger or Facility Issue</option>
      </select>
    </div>

    <div class="cers-form-group">
      <label for="severity" class="cers-form-label">Severity Assessment</label>
      <select id="severity" class="cers-form-control">
        <option value="">Auto-Classify (Calculated from Incident Type)</option>
        <option value="critical">Critical (Immediate threat to life or safety)</option>
        <option value="high">High (Urgent situation requiring rapid dispatch)</option>
        <option value="medium">Medium (Moderate concern / localized hazard)</option>
        <option value="low">Low (Non-emergency notification / minor issue)</option>
      </select>
    </div>

    <div class="cers-form-group">
      <label for="description" class="cers-form-label">Description & Precise Campus Location</label>
      <textarea id="description" class="cers-form-control" rows="4" required placeholder="Specify building, floor, room number, or nearby landmark (e.g., Science Complex Block B, Room 204 electrical box sparking)."></textarea>
    </div>

    <!-- GPS Coordinates -->
    <div class="row g-2">
      <div class="col-6 cers-form-group">
        <label for="latitude" class="cers-form-label">GPS Latitude</label>
        <input type="number" step="any" id="latitude" class="cers-form-control" placeholder="Acquiring GPS...">
      </div>
      <div class="col-6 cers-form-group">
        <label for="longitude" class="cers-form-label">GPS Longitude</label>
        <input type="number" step="any" id="longitude" class="cers-form-control" placeholder="Acquiring GPS...">
      </div>
    </div>

    <div id="report-feedback" class="cers-form-feedback"></div>

    <div class="d-flex gap-2 mt-4 pt-3" style="border-top: 1px solid var(--cers-border);">
      <button type="submit" class="cers-btn cers-btn-primary flex-grow-1">DISPATCH REPORT</button>
      <a href="/dashboard" class="cers-btn cers-btn-secondary">CANCEL</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
