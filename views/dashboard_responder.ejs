<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/sidebar') %>

<!-- Responder Unit Tactical Command Status Banner -->
<% 
  let activeIncidentsCount = incidents.filter(i => i.status !== 'resolved').length;
%>
<div class="cers-circular-meter-card">
  <div>
    <div style="font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.75px; color: #94a3b8;">
      COMMAND DISPATCH TERMINAL
    </div>
    <div style="font-weight: 800; font-size: 1.25rem; text-transform: uppercase; color: #ffffff; margin-top: 0.25rem;">
      <%= user.response_unit_type %> Response Unit
    </div>
    <p style="font-size: 0.78rem; color: #cbd5e1; margin-top: 0.25rem; max-width: 480px;">
      Emergency transmissions matching your discipline are routed directly to this terminal. Acknowledge, dispatch, and resolve incident lifecycle states.
    </p>
  </div>
  
  <div class="cers-circular-meter">
    <div class="cers-circular-meter-val"><%= activeIncidentsCount %></div>
    <div class="cers-circular-meter-label">Active Alerts</div>
  </div>
</div>

<!-- Tabs Selector Switcher (Hidden on desktop as columns are side-by-side) -->
<div class="cers-tabs-switcher d-lg-none">
  <div class="cers-tab-btn cers-active" onclick="window.location.hash='#active-incidents';">Assigned Dispatch Queue</div>
  <div class="cers-tab-btn" onclick="window.location.hash='#notifications';">Live Alert Transmissions</div>
</div>

<div class="row g-4">
  <!-- Left/Main Column: Routed Incidents -->
  <div class="col-xl-8 col-lg-7" id="active-incidents" style="scroll-margin-top: 20px;">
    <div class="cers-card">
      <div class="cers-card-title">
        <span>Routed Incident Dispatch Queue</span>
        <span class="cers-pill cers-pill-status-in_progress"><%= activeIncidentsCount %> Pending</span>
      </div>
      <p class="text-muted" style="font-size: 0.78rem; margin-bottom: 1.15rem;">Emergencies routed according to category dispatch matrix.</p>
      
      <% if (incidents.length === 0) { %>
        <div class="text-center py-5" style="border: 1px dashed var(--cers-border); border-radius: var(--cers-radius); background-color: var(--cers-bg-subtle);">
          <p class="text-muted" style="font-size: 0.82rem; margin-bottom: 0;">No active emergency dispatches currently assigned to your unit.</p>
        </div>
      <% } else { %>
        <div class="cers-list-feed">
          <% incidents.forEach(incident => { %>
            <% 
              let iconSvg = '';
              let iconColorClass = '';
              if (incident.category === 'fire') {
                iconColorClass = 'cers-icon-danger';
                iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3.5z"/></svg>';
              } else if (incident.category === 'medical') {
                iconColorClass = 'cers-icon-danger';
                iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>';
              } else if (incident.category === 'security') {
                iconColorClass = 'cers-icon-danger';
                iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>';
              } else if (incident.category === 'accident') {
                iconColorClass = '';
                iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
              } else {
                iconColorClass = '';
                iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
              }
            %>
            <div class="cers-list-item" style="<%= incident.status === 'reported' ? 'border-left: 4px solid var(--cers-warning); background-color: rgba(245, 158, 11, 0.04);' : '' %>">
              <div class="cers-list-icon <%= iconColorClass %>">
                <%- iconSvg %>
              </div>
              <div class="cers-list-details">
                <div class="cers-list-title">Incident #<%= incident.id %> — <%= incident.category.toUpperCase() %></div>
                <div class="cers-list-subtitle">
                  Reporter: <strong><%= incident.reporter_name %></strong> &bull; <%= incident.description || 'Distress signal received' %>
                </div>
                <div style="font-size: 0.68rem; color: var(--cers-text-muted); margin-top: 0.15rem;">
                  Reported <%= new Date(incident.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %> (<%= new Date(incident.created_at).toLocaleDateString() %>)
                </div>
              </div>
              <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem;">
                <div style="display: flex; gap: 0.35rem;">
                  <span class="cers-pill cers-pill-severity-<%= incident.severity %>">
                    <%= incident.severity %>
                  </span>
                  <span class="cers-pill cers-pill-status-<%= incident.status %>">
                    <%= incident.status %>
                  </span>
                </div>
                <a href="/incidents/<%= incident.id %>" class="cers-btn cers-btn-primary" style="font-size: 0.72rem; padding: 0.25rem 0.65rem; text-transform: none;">
                  Respond & Update
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Right Column: Live Notifications -->
  <div class="col-xl-4 col-lg-5" id="notifications" style="scroll-margin-top: 20px;">
    <div class="cers-card">
      <div class="cers-card-title">
        <span>Live Alert Transmissions</span>
        <span class="cers-pill cers-pill-status-dispatched">Real-Time Polling</span>
      </div>
      <p class="text-muted" style="font-size: 0.78rem; margin-bottom: 1.15rem;">Direct broadcasts pushed from student distress buttons and dispatcher filings.</p>
      
      <div class="cers-notification-feed" id="cers-notification-feed-container">
        <div class="text-center py-4">
          <div class="spinner-border text-primary" role="status" style="width: 1.25rem; height: 1.25rem; border-width: 2px;"></div>
          <p class="text-muted mt-2" style="font-size: 0.75rem;">Awaiting incoming dispatch transmissions...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Tab toggle scripting for mobile responsive views -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.cers-tab-btn');
    const activeIncidentsCol = document.getElementById('active-incidents');
    const notificationsCol = document.getElementById('notifications');

    function activateTab(targetId) {
      tabs.forEach(tab => {
        if (tab.innerText.toLowerCase().includes(targetId === 'active-incidents' ? 'queue' : 'transmissions')) {
          tab.classList.add('cers-active');
        } else {
          tab.classList.remove('cers-active');
        }
      });

      // Responsive display toggle on mobile (below lg viewport size)
      if (window.innerWidth < 992) {
        if (targetId === 'active-incidents') {
          activeIncidentsCol.style.setProperty('display', 'block', 'important');
          notificationsCol.style.setProperty('display', 'none', 'important');
        } else {
          activeIncidentsCol.style.setProperty('display', 'none', 'important');
          notificationsCol.style.setProperty('display', 'block', 'important');
        }
      }
    }

    window.addEventListener('hashchange', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash === 'active-incidents' || hash === 'notifications') {
        activateTab(hash);
      }
    });

    // Initial check
    const initialHash = window.location.hash.replace('#', '');
    if (initialHash === 'active-incidents' || initialHash === 'notifications') {
      activateTab(initialHash);
    } else {
      // Default to active incidents view on mobile
      activateTab('active-incidents');
    }

    // Reset inline display styles on window resize to ensure desktop layout displays both columns
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 992) {
        activeIncidentsCol.style.removeProperty('display');
        notificationsCol.style.removeProperty('display');
      } else {
        const activeTab = document.querySelector('.cers-tab-btn.cers-active');
        const activeId = activeTab && activeTab.innerText.toLowerCase().includes('transmissions') ? 'notifications' : 'active-incidents';
        activateTab(activeId);
      }
    });
  });
</script>

<%- include('partials/footer') %>
