<%- include('partials/header') %>

<div class="cers-auth-wrapper">
  <div class="cers-auth-backdrop">
    
    <!-- Left Pane: Tagline & abstract wavy lines matching Monex visual decoration -->
    <div class="cers-auth-info-pane">
      <svg style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;" viewBox="0 0 100 100" preserveAspectRatio="none">
        <circle cx="0" cy="100" r="80" fill="rgba(255,255,255,0.03)" />
        <circle cx="100" cy="0" r="50" fill="rgba(255,255,255,0.05)" />
        <path d="M-10,90 Q30,50 70,80 T110,60" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="2" />
        <path d="M-10,100 Q40,70 80,90 T110,80" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="4" />
      </svg>
      
      <div style="z-index: 10;">
        <span style="background-color: rgba(255,255,255,0.18); color: #ffffff; padding: 0.35rem 0.75rem; border-radius: var(--cers-radius-pill); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; display: inline-block; margin-bottom: 1.5rem;">
          SYSTEM ONLINE
        </span>
        <h1>Campus Emergency Response & Reporting System: Real-Time Dispatch.</h1>
      </div>
    </div>
    
    <!-- Right Pane: Login Card -->
    <div class="cers-auth-form-pane">
      
      <!-- Brand Logo Header -->
      <div style="display: flex; align-items: center; justify-content: flex-start; gap: 0.5rem; margin-bottom: 1.25rem;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: #2563eb;">
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        </svg>
        <span style="font-weight: 800; font-size: 1.35rem; color: #2563eb; letter-spacing: -0.5px;">CampusAlert</span>
      </div>

      <div style="font-weight: 800; font-size: 1.2rem; color: var(--cers-text-main); margin-bottom: 0.2rem;">Welcome Back!</div>
      <div class="text-muted" style="font-size: 0.78rem; margin-bottom: 1.25rem;">Sign in to check dispatch feeds and reports.</div>
      
      <form id="cers-login-form">
        <!-- Floating Label 1 -->
        <div class="cers-input-wrapper">
          <label for="email" class="cers-input-label">Email Address</label>
          <input type="email" id="email" class="cers-input-field" required placeholder="name@campusalert.edu">
        </div>
        
        <!-- Floating Label 2 -->
        <div class="cers-input-wrapper">
          <label for="password" class="cers-input-label">Password</label>
          <input type="password" id="password" class="cers-input-field" required placeholder="••••••••">
        </div>
        
        <!-- Checkbox row -->
        <div class="d-flex justify-content-between align-items-center mb-4" style="font-size: 0.78rem; font-weight: 600;">
          <label style="display: flex; align-items: center; gap: 0.35rem; cursor: pointer; color: var(--cers-text-muted);">
            <input type="checkbox" style="accent-color: var(--cers-accent);"> Remember me
          </label>
          <a href="#" style="color: var(--cers-accent);">Forgot Password?</a>
        </div>
        
        <div id="auth-feedback" class="cers-form-feedback"></div>
        
        <button type="submit" class="cers-btn cers-btn-primary cers-btn-block mt-3">LOGIN</button>
      </form>
      
      <!-- Divider -->
      <div style="text-align: center; margin: 1rem 0; font-size: 0.72rem; color: var(--cers-text-muted); font-weight: 700; text-transform: uppercase; position: relative;">
        <span style="background: #ffffff; padding: 0 10px; position: relative; z-index: 10;">or</span>
        <div style="position: absolute; top: 50%; left: 0; right: 0; border-top: 1px solid var(--cers-border); z-index: 1;"></div>
      </div>
      
      <!-- Social Sign-in -->
      <button class="cers-btn cers-btn-secondary cers-btn-block" style="display: flex; gap: 0.5rem; justify-content: center; align-items: center; font-size: 0.8rem; text-transform: none;" onclick="alert('Google login placeholder matching layout mockup.')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.24 10.285V14.4h6.887c-.648 2.41-2.519 4.114-5.136 4.114-3.51 0-6.38-2.87-6.38-6.38s2.87-6.38 6.38-6.38c1.6 0 3.033.585 4.14 1.545l3.078-3.078C19.3 2.54 16.03 1 12.24 1 5.86 1 .7 6.16.7 12.54S5.86 24.08 12.24 24.08c6.24 0 11.23-5.06 11.23-11.23 0-.756-.09-1.485-.24-2.185H12.24z"/>
        </svg>
        Sign in with Google
      </button>

    </div>
    
  </div>
</div>

<%- include('partials/footer') %>
