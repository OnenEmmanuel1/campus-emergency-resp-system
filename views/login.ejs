<%- include('partials/header') %>

<div class="cers-auth-wrapper">
  <div class="cers-auth-backdrop">
    
    <!-- Left Pane: Institutional Security Briefing -->
    <div class="cers-auth-info-pane">
      <div>
        <span style="background-color: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #ffffff; padding: 0.35rem 0.75rem; border-radius: var(--cers-radius-sm); font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; display: inline-block;">
          SECURE DISPATCH NETWORK
        </span>
        <h1>Campus Emergency Response & Reporting System</h1>
        <p style="color: #94a3b8; font-size: 0.82rem; margin-top: 0.75rem; line-height: 1.5; max-width: 360px;">
          Centralized tertiary institutional safety network connecting students, faculty, campus police, fire services, and emergency medical teams.
        </p>
      </div>

      <div style="background-color: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); border-radius: var(--cers-radius); padding: 1.2rem; margin-top: 1.5rem;">
        <div style="font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; margin-bottom: 0.4rem;">
          Pre-Seeded Access Accounts
        </div>
        <div style="font-size: 0.72rem; color: #cbd5e1; line-height: 1.45;">
          <strong>Admin:</strong> admin@campusalert.edu<br>
          <strong>Security:</strong> security@campusalert.edu<br>
          <strong>Medical / Fire:</strong> medical@campusalert.edu / fire@campusalert.edu<br>
          <strong>Reporter:</strong> john@campusalert.edu<br>
          <span style="color: #93c5fd; font-weight: 700; margin-top: 0.25rem; display: inline-block;">Password for all: password123</span>
        </div>
      </div>
    </div>
    
    <!-- Right Pane: Login Card -->
    <div class="cers-auth-form-pane">
      
      <!-- Brand Logo Header -->
      <div style="display: flex; align-items: center; justify-content: flex-start; gap: 0.5rem; margin-bottom: 1.5rem;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--cers-danger);">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span style="font-weight: 800; font-size: 1.2rem; color: var(--cers-primary); letter-spacing: -0.5px;">CampusAlert</span>
      </div>

      <div style="font-weight: 800; font-size: 1.15rem; color: var(--cers-primary); margin-bottom: 0.2rem;">Sign In</div>
      <div class="text-muted" style="font-size: 0.78rem; margin-bottom: 1.25rem;">Access dispatch feeds and submit reports.</div>
      
      <form id="cers-login-form">
        <!-- Input 1 -->
        <div class="cers-input-wrapper">
          <label for="email" class="cers-input-label">Campus Email</label>
          <input type="email" id="email" class="cers-input-field" required placeholder="name@campusalert.edu">
        </div>
        
        <!-- Input 2 -->
        <div class="cers-input-wrapper">
          <label for="password" class="cers-input-label">Password</label>
          <input type="password" id="password" class="cers-input-field" required placeholder="••••••••">
        </div>
        
        <!-- Action Row -->
        <div class="d-flex justify-content-between align-items-center mb-3" style="font-size: 0.75rem; font-weight: 600;">
          <label style="display: flex; align-items: center; gap: 0.35rem; cursor: pointer; color: var(--cers-text-muted);">
            <input type="checkbox" style="accent-color: var(--cers-accent);"> Remember terminal
          </label>
          <a href="/register" style="color: var(--cers-accent);">Create account</a>
        </div>
        
        <div id="auth-feedback" class="cers-form-feedback"></div>
        
        <button type="submit" class="cers-btn cers-btn-primary cers-btn-block mt-2">LOGIN TO SYSTEM</button>
      </form>

      <div class="text-center mt-3 pt-3" style="font-size: 0.75rem; border-top: 1px solid var(--cers-border-subtle); color: var(--cers-text-muted);">
        Institutional Safety & Emergency Dispatch System
      </div>

    </div>
    
  </div>
</div>

<%- include('partials/footer') %>
