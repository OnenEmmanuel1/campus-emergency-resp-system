<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/sidebar') %>

<!-- Summary statistics cards mapping (expenses equivalent) -->
<div class="cers-summary-cards">
  <% 
    let totalCount = incidents.length;
    let activeCount = incidents.filter(i => i.status !== 'resolved').length;
    let resolvedCount = incidents.filter(i => i.status === 'resolved').length;
  %>
  <div class="cers-summary-card">
    <div class="cers-summary-val"><%= totalCount %></div>
    <div class="cers-summary-label">Total</div>
  </div>
  <div class="cers-summary-card cers-active-card">
    <div class="cers-summary-val"><%= activeCount %></div>
    <div class="cers-summary-label">Active</div>
  </div>
  <div class="cers-summary-card">
    <div class="cers-summary-val"><%= resolvedCount %></div>
    <div class="cers-summary-label">Resolved</div>
  </div>
</div>

<!-- Dominant Emergency FAB Screen Control -->
<div class="cers-card text-center" style="background-color: #fef2f2; border: 2px solid var(--cers-danger);">
  <div style="font-weight: 800; color: var(--cers-critical); font-size: 1.1rem; text-transform: uppercase; margin-bottom: 0.35rem; display: flex; align-items: center; justify-content: center; gap: 0.35rem;">
    <span class="cers-pulse-icon"></span>
    Emergency Dispatcher
  </div>
  <p class="text-muted" style="font-size: 0.75rem; margin-bottom: 1.25rem;">Broadcast GPS coordinates to security responders immediately.</p>
  
  <div style="display: flex; justify-content: center; align-items: center; padding: 0.5rem 0;">
    <button id="cers-btn-one-click-trigger" class="cers-btn-emergency" style="width: 150px; height: 150px; background-color: var(--cers-danger); border: 8px solid #fee2e2; border-radius: 50%; color: white; font-weight: 800; font-size: 1.8rem; box-shadow: var(--cers-shadow-alert); cursor: pointer; display: flex; flex-direction: column; justify-content: center; align-items: center; transition: transform 0.15s;">
      HELP
      <span style="font-size: 0.65rem; font-weight: 600; opacity: 0.9; margin-top: 0.25rem; letter-spacing: 0.25px;">Broadcast GPS</span>
    </button>
  </div>
  
  <div id="cers-one-click-status" style="font-size: 0.72rem; color: var(--cers-danger); font-weight: 700; height: 18px; margin-top: 0.75rem;"></div>
</div>

<!-- Secondary Actions -->
<div class="cers-card">
  <div class="cers-card-title">File Details Report</div>
  <p class="text-muted" style="font-size: 0.78rem; margin-bottom: 1rem;">Have details about a hazard, fire risk, or suspicious event? Submit a report form.</p>
  <a href="/incidents/report" class="cers-btn cers-btn-primary cers-btn-block">OPEN DETAILED REPORT FORM</a>
</div>

<!-- History log feed mapping (latest entries equivalent) -->
<div class="cers-card" id="my-reports">
  <div class="cers-card-title">Latest Entries</div>
  
  <% if (incidents.length === 0) { %>
    <p class="text-muted text-center py-4" style="font-size: 0.8rem;">No emergency entries reported.</p>
  <% } else { %>
    <div class="cers-list-feed">
      <% incidents.forEach(incident => { %>
        <!-- Map SVG icons by category -->
        <% 
          let iconSvg = '';
          let iconColorClass = '';
          if (incident.category === 'fire') {
            iconColorClass = 'cers-icon-danger';
            iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3.5z"/></svg>';
          } else if (incident.category === 'medical') {
            iconColorClass = 'cers-icon-danger';
            iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>';
          } else if (incident.category === 'security') {
            iconColorClass = 'cers-icon-danger';
            iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>';
          } else if (incident.category === 'accident') {
            iconColorClass = '';
            iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
          } else {
            iconColorClass = '';
            iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
          }
        %>
        <div class="cers-list-item">
          <div class="cers-list-icon <%= iconColorClass %>">
            <%- iconSvg %>
          </div>
          <div class="cers-list-details">
            <div class="cers-list-title">Category: <%= incident.category.toUpperCase() %></div>
            <div class="cers-list-subtitle">
              <%= incident.description || 'One-click alert triggered' %>
            </div>
            <div style="font-size: 0.65rem; color: var(--cers-text-muted); margin-top: 0.15rem;">
              <%= new Date(incident.created_at).toLocaleDateString() %>
            </div>
          </div>
          <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem;">
            <span class="cers-pill cers-pill-status-<%= incident.status %>">
              <%= incident.status %>
            </span>
            <a href="/incidents/<%= incident.id %>" class="cers-btn cers-btn-secondary" style="font-size: 0.72rem; padding: 0.25rem 0.5rem; text-transform: none; border-radius: 8px;">
              Details
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
