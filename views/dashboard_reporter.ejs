<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/sidebar') %>

<div class="row g-4">
  <!-- Left/Main Column -->
  <div class="col-xl-8 col-lg-7">
    
    <!-- Reporter Summary Metrics -->
    <div class="cers-summary-cards">
      <% 
        let totalCount = incidents.length;
        let activeCount = incidents.filter(i => i.status !== 'resolved').length;
        let resolvedCount = incidents.filter(i => i.status === 'resolved').length;
      %>
      <div class="cers-summary-card">
        <div class="cers-summary-val"><%= totalCount %></div>
        <div class="cers-summary-label">Filed Reports</div>
      </div>
      <div class="cers-summary-card cers-active-card">
        <div class="cers-summary-val"><%= activeCount %></div>
        <div class="cers-summary-label">Active Transmissions</div>
      </div>
      <div class="cers-summary-card">
        <div class="cers-summary-val"><%= resolvedCount %></div>
        <div class="cers-summary-label">Resolved / Closed</div>
      </div>
    </div>

    <!-- Instant Distress Alert Control -->
    <div class="cers-card" style="background-color: #fff5f5; border: 1px solid #fee2e2; text-align: center; box-shadow: 0 10px 25px rgba(239, 68, 68, 0.04);">
      <div style="font-weight: 800; color: var(--cers-critical); font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.25rem; display: flex; align-items: center; justify-content: center; gap: 0.45rem;">
        <span class="cers-pulse-icon"></span>
        Instant Campus Emergency Trigger
      </div>
      <p class="text-muted" style="font-size: 0.78rem; margin-bottom: 1.25rem;">Immediately captures your browser GPS coordinates and alerts on-duty security and medical dispatch units.</p>
      
      <div style="display: flex; justify-content: center; align-items: center; padding: 0.5rem 0;">
        <button id="cers-btn-one-click-trigger" class="cers-btn-emergency" style="width: 130px; height: 130px; background-color: var(--cers-danger); border: 4px solid #ffffff; box-shadow: 0 10px 20px rgba(239, 68, 68, 0.25); border-radius: 50%; color: white; font-weight: 800; font-size: 1.6rem; cursor: pointer; display: flex; flex-direction: column; justify-content: center; align-items: center; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); outline: none;">
          SOS
          <span style="font-size: 0.65rem; font-weight: 700; opacity: 0.95; margin-top: 0.25rem; letter-spacing: 0.5px; text-transform: uppercase;">Broadcast GPS</span>
        </button>
      </div>
      
      <div id="cers-one-click-status" style="font-size: 0.72rem; color: var(--cers-danger); font-weight: 800; height: 18px; margin-top: 0.75rem; letter-spacing: 0.25px;"></div>
    </div>

    <!-- History Log Feed -->
    <div class="cers-card" id="my-reports">
      <div class="cers-card-title">My Filed Emergency Reports</div>
      
      <% if (incidents.length === 0) { %>
        <div class="text-center py-4" style="border: 1px dashed var(--cers-border); border-radius: var(--cers-radius); background-color: var(--cers-bg-subtle);">
          <p class="text-muted" style="font-size: 0.8rem; margin-bottom: 0;">You have not submitted any emergency reports.</p>
        </div>
      <% } else { %>
        <div class="cers-list-feed">
          <% incidents.forEach(incident => { %>
            <% 
              let iconSvg = '';
              let iconColorClass = '';
              if (incident.category === 'fire') {
                iconColorClass = 'cers-icon-danger';
                iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3.5z"/></svg>';
              } else if (incident.category === 'medical') {
                iconColorClass = 'cers-icon-danger';
                iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>';
              } else if (incident.category === 'security') {
                iconColorClass = 'cers-icon-danger';
                iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>';
              } else if (incident.category === 'accident') {
                iconColorClass = '';
                iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
              } else {
                iconColorClass = '';
                iconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
              }
            %>
            <div class="cers-list-item">
              <div class="cers-list-icon <%= iconColorClass %>">
                <%- iconSvg %>
              </div>
              <div class="cers-list-details">
                <div class="cers-list-title">Incident #<%= incident.id %> — <%= incident.category.toUpperCase() %></div>
                <div class="cers-list-subtitle">
                  <%= incident.description || 'One-click emergency alert triggered' %>
                </div>
                <div style="font-size: 0.68rem; color: var(--cers-text-muted); margin-top: 0.15rem;">
                  Submitted on <%= new Date(incident.created_at).toLocaleDateString() %> at <%= new Date(incident.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                </div>
              </div>
              <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem;">
                <span class="cers-pill cers-pill-status-<%= incident.status %>">
                  <%= incident.status %>
                </span>
                <a href="/incidents/<%= incident.id %>" class="cers-btn cers-btn-secondary" style="font-size: 0.72rem; padding: 0.25rem 0.6rem; text-transform: none;">
                  View Status
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Right/Sidebar Column -->
  <div class="col-xl-4 col-lg-5">
    <!-- Detailed Emergency Report Form trigger -->
    <div class="cers-card">
      <div class="cers-card-title" style="margin-bottom: 0.35rem;">Detailed Report Form</div>
      <p class="text-muted" style="font-size: 0.78rem; margin-bottom: 1.25rem;">Have details regarding a hazard, lab smoke, injury, or suspicious activity? Complete the full report form to supply descriptive details.</p>
      <a href="/incidents/report" class="cers-btn cers-btn-primary w-100">OPEN REPORT FORM</a>
    </div>

    <!-- Quick Help / Instructions Card -->
    <div class="cers-card">
      <div class="cers-card-title" style="margin-bottom: 0.35rem;">Emergency Guidelines</div>
      <p class="text-muted" style="font-size: 0.78rem; margin-bottom: 1.15rem;">If you are in danger or reporting an active hazard, remember to stay calm and follow procedures:</p>
      <ul style="font-size: 0.78rem; color: var(--cers-text-main); padding-left: 1.15rem; line-height: 1.6; display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.5rem;">
        <li><strong>Ensure Personal Safety first</strong>. Move away from active fire or hazardous gas locations.</li>
        <li><strong>Trigger the SOS Broadcast</strong> to lock onto your GPS position so dispatch can locate you immediately.</li>
        <li><strong>Detail location notes</strong> in reports, specifying room or floor.</li>
        <li><strong>Cooperate with safety units</strong> on scene when security or medical units arrive.</li>
      </ul>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
