<%- include('partials/header') %>

<div class="cers-auth-wrapper">
  <div class="cers-auth-backdrop">
    
    <!-- Left Pane: Institutional Security Briefing -->
    <div class="cers-auth-info-pane">
      <div>
        <span style="background-color: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #ffffff; padding: 0.35rem 0.75rem; border-radius: var(--cers-radius-sm); font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; display: inline-block;">
          ACCOUNT REGISTRATION
        </span>
        <h1>Join the CampusAlert Response Network</h1>
        <p style="color: #94a3b8; font-size: 0.82rem; margin-top: 0.75rem; line-height: 1.5; max-width: 360px;">
          Register as a campus reporter (Student or Staff) to file emergency incidents, receive real-time updates, and broadcast instant GPS distress alerts.
        </p>
      </div>

      <div style="background-color: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px); border-radius: var(--cers-radius); padding: 1.2rem; margin-top: 1.5rem;">
        <div style="font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; margin-bottom: 0.3rem;">
          Safety Compliance Protocol
        </div>
        <div style="font-size: 0.72rem; color: #cbd5e1; line-height: 1.45;">
          Your account is authorized to file campus safety reports, medical requests, fire alerts, and security notifications with verified audit tracking.
        </div>
      </div>
    </div>
    
    <!-- Right Pane: Register Card -->
    <div class="cers-auth-form-pane">
      
      <!-- Brand Logo Header -->
      <div style="display: flex; align-items: center; justify-content: flex-start; gap: 0.5rem; margin-bottom: 1.5rem;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--cers-danger);">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span style="font-weight: 800; font-size: 1.2rem; color: var(--cers-primary); letter-spacing: -0.5px;">CampusAlert</span>
      </div>

      <div style="font-weight: 800; font-size: 1.15rem; color: var(--cers-primary); margin-bottom: 0.2rem;">Create Reporter Profile</div>
      <div class="text-muted" style="font-size: 0.78rem; margin-bottom: 1.25rem;">Student or Faculty safety dispatch account.</div>
      
      <form id="cers-register-form">
        <!-- Full Name -->
        <div class="cers-input-wrapper">
          <label for="name" class="cers-input-label">Full Name</label>
          <input type="text" id="name" class="cers-input-field" required placeholder="e.g. John Doe">
        </div>

        <!-- Campus Email -->
        <div class="cers-input-wrapper">
          <label for="email" class="cers-input-label">Campus Email</label>
          <input type="email" id="email" class="cers-input-field" required placeholder="e.g. jdoe@campusalert.edu">
        </div>
        
        <!-- Password -->
        <div class="cers-input-wrapper">
          <label for="password" class="cers-input-label">Password</label>
          <input type="password" id="password" class="cers-input-field" required placeholder="Minimum 6 characters">
        </div>
        
        <div id="auth-feedback" class="cers-form-feedback"></div>
        
        <button type="submit" class="cers-btn cers-btn-primary cers-btn-block mt-2">REGISTER ACCOUNT</button>
      </form>
      
      <div class="text-center mt-3 pt-3" style="font-size: 0.78rem; border-top: 1px solid var(--cers-border-subtle);">
        <span class="text-muted">Already registered?</span> <a href="/login">Log in here</a>
      </div>
    </div>
    
  </div>
</div>

<%- include('partials/footer') %>
