<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'CampusAlert - Campus Emergency Response System' %></title>
  
  <!-- SEO tags -->
  <meta name="description" content="CampusAlert is the official tertiary campus emergency reporting and dispatch routing system, keeping campus communities safe.">
  <meta name="robots" content="noindex, nofollow">
  
  <!-- Bootstrap 5 Grid System & Helpers CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
  
  <!-- Custom Flat Color CSS design system -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Centered App Shell -->
  <div class="cers-mobile-shell">
    
    <!-- Toast Flash Notifications -->
    <% if (typeof flashSuccess !== 'undefined' && flashSuccess) { %>
      <div class="cers-toast cers-toast-success" onclick="this.style.display='none';">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <span><%= flashSuccess %></span>
      </div>
    <% } %>

    <% if (typeof flashError !== 'undefined' && flashError) { %>
      <div class="cers-toast cers-toast-error" onclick="this.style.display='none';">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span><%= flashError %></span>
      </div>
    <% } %>
    
    <!-- Top Mobile Brand Header (Visible only when logged in) -->
    <% if (typeof user !== 'undefined' && user) { %>
      <header class="cers-mobile-header">
        <div class="cers-mobile-brand">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>CampusAlert <span style="font-size: 0.7rem; font-weight: 600; color: var(--cers-text-muted); text-transform: uppercase; letter-spacing: 0.5px; border-left: 1px solid var(--cers-border); padding-left: 0.5rem; margin-left: 0.25rem;">CERRS</span></span>
        </div>
        
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <span class="cers-badge-role">
            <%= user.role === 'response_unit' ? `${user.response_unit_type.toUpperCase()} DISPATCH` : user.role.toUpperCase() %>
          </span>
          
          <!-- Notification Bell Button -->
          <div style="position: relative;">
            <button id="cers-nav-notification-btn" aria-label="Notifications" style="background: none; border: 1px solid var(--cers-border); color: var(--cers-text-main); cursor: pointer; display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: var(--cers-radius); background-color: #ffffff; outline: none; position: relative;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
              </svg>
              <!-- Badge -->
              <span id="cers-notification-badge" style="display: none; position: absolute; top: -4px; right: -4px; background-color: var(--cers-danger); color: white; border-radius: var(--cers-radius-pill); font-size: 0.6rem; min-width: 16px; height: 16px; font-weight: 800; justify-content: center; align-items: center; line-height: 1; border: 1px solid #ffffff; padding: 0 2px;">0</span>
            </button>

            <!-- Notification Dropdown Menu Tray -->
            <div id="cers-notification-dropdown" style="display: none; position: absolute; top: 40px; right: 0; width: 300px; background: white; border: 1px solid var(--cers-border); border-radius: var(--cers-radius); box-shadow: var(--cers-shadow-elevated); z-index: 1050; overflow: hidden; text-align: left;">
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.65rem 0.85rem; border-bottom: 1px solid var(--cers-border); background-color: #f8fafc;">
                <span style="font-weight: 800; font-size: 0.75rem; color: var(--cers-primary); text-transform: uppercase; letter-spacing: 0.5px;">Emergency Dispatch Feed</span>
                <button id="cers-mark-all-read" style="background: none; border: none; color: var(--cers-accent); font-size: 0.68rem; font-weight: 700; cursor: pointer; padding: 0; outline: none;">Mark read</button>
              </div>
              <div id="cers-notification-list" style="max-height: 260px; overflow-y: auto; font-size: 0.75rem; color: var(--cers-text-main);">
                <div style="padding: 1.5rem; text-align: center; color: var(--cers-text-muted);">No new notifications.</div>
              </div>
            </div>
          </div>

          <div style="width: 34px; height: 34px; border-radius: 8px; background-color: #e6f4f1; color: var(--cers-accent); display: flex; justify-content: center; align-items: center; font-weight: 800; font-size: 0.8rem; text-transform: uppercase; flex-shrink: 0; border: 1px solid rgba(15, 150, 117, 0.15);" title="<%= user.name %>">
            <%= user.name.split(' ').map(n => n[0]).join('').substring(0, 2) %>
          </div>
        </div>
      </header>
    <% } %>

    <!-- Scrollable Content Frame -->
    <div class="cers-content-area<%= typeof user === 'undefined' || !user ? ' cers-no-sidebar' : '' %>">
