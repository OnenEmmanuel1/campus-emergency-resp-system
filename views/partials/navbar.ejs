<% if (typeof user !== 'undefined' && user) { %>
  <!-- Fixed Bottom Navigation (Monex Style) -->
  <nav class="cers-bottom-nav">
    
    <!-- Tab 1: Home Dashboard -->
    <a href="/dashboard" class="cers-nav-tab cers-active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <span>Home</span>
    </a>

    <% if (user.role === 'reporter') { %>
      <!-- Tab 2: File Detailed Report -->
      <a href="/incidents/report" class="cers-nav-tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        <span>Report</span>
      </a>
      
      <!-- Center: Emergency FAB -->
      <div class="cers-fab-holder">
        <button id="cers-navbar-emergency-trigger" class="cers-btn-fab" title="INSTANT EMERGENCY ALERT">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </button>
      </div>

      <!-- Tab 3: History (Link to anchor) -->
      <a href="/dashboard#my-reports" class="cers-nav-tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span>History</span>
      </a>
    <% } %>

    <% if (user.role === 'response_unit') { %>
      <!-- Tab 2: Dispatch Log -->
      <a href="/dashboard#active-incidents" class="cers-nav-tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span>Dispatch</span>
      </a>

      <!-- Center: Status FAB -->
      <div class="cers-fab-holder">
        <button id="cers-navbar-emergency-trigger" class="cers-btn-fab" title="INSTANT ALERT">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </button>
      </div>

      <!-- Tab 3: Notifications -->
      <a href="/dashboard#notifications" class="cers-nav-tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <span>Feed</span>
      </a>
    <% } %>

    <% if (user.role === 'admin') { %>
      <!-- Tab 2: Log Logs -->
      <a href="/dashboard#incidents-log" class="cers-nav-tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span>Logs</span>
      </a>

      <!-- Center: Emergency FAB -->
      <div class="cers-fab-holder">
        <button id="cers-navbar-emergency-trigger" class="cers-btn-fab" title="INSTANT ALERT">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </button>
      </div>

      <!-- Tab 3: User control -->
      <a href="/dashboard#users-control" class="cers-nav-tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <span>Users</span>
      </a>
    <% } %>

    <!-- Tab 4: Logout profile trigger -->
    <a href="#" id="cers-btn-logout-nav" class="cers-nav-tab">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
      <span>Logout</span>
    </a>
    
  </nav>
<% } %>
