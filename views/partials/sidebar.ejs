<% if (user) { %>
<aside class="cers-sidebar">
  
  <!-- User Profile Section -->
  <div style="display: flex; align-items: center; gap: 0.75rem; padding-bottom: 1rem; border-bottom: 1px solid var(--cers-border); margin-bottom: 0.75rem;">
    <div style="width: 38px; height: 38px; border-radius: 10px; background-color: #e6f4f1; color: var(--cers-accent); display: flex; justify-content: center; align-items: center; font-weight: 800; font-size: 0.95rem; flex-shrink: 0; text-transform: uppercase; border: 1px solid rgba(15, 150, 117, 0.15);">
      <%= user.name.split(' ').map(n => n[0]).join('').substring(0, 2) %>
    </div>
    <div style="min-width: 0; flex: 1;">
      <div style="font-weight: 700; font-size: 0.85rem; color: var(--cers-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= user.name %>">
        <%= user.name %>
      </div>
      <div style="font-size: 0.65rem; color: var(--cers-text-muted); text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px; margin-top: 0.1rem;">
        <%= user.role === 'response_unit' ? `${user.response_unit_type.toUpperCase()} DISPATCH` : user.role.toUpperCase() %>
      </div>
    </div>
  </div>

  <div style="font-size: 0.68rem; font-weight: 800; color: var(--cers-text-muted); text-transform: uppercase; letter-spacing: 0.75px; padding: 0.25rem 0.5rem; margin-bottom: 0.25rem;">
    Terminal Navigation
  </div>
  
  <div class="cers-sidebar-menu" style="display: flex; flex-direction: column; gap: 0.25rem;">
    <a href="/dashboard" class="cers-sidebar-item">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      Dashboard
    </a>
    
    <% if (user.role === 'reporter') { %>
      <div class="p-2 mb-1 mt-1" style="background-color: #fff5f5; border: 1px solid #fee2e2; border-radius: var(--cers-radius);">
        <button id="cers-sidebar-emergency-trigger" class="cers-btn cers-btn-danger w-100 py-2" style="font-weight: 800; font-size: 0.78rem;">
          INSTANT ALERT
        </button>
        <div id="cers-sidebar-emergency-status" style="font-size: 0.65rem; text-align: center; color: var(--cers-danger); font-weight: 700; margin-top: 0.25rem; height: 14px; overflow: hidden;"></div>
      </div>
      
      <a href="/incidents/report" class="cers-sidebar-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="12" y1="18" x2="12" y2="12"/>
          <line x1="9" y1="15" x2="15" y2="15"/>
        </svg>
        New Report Form
      </a>
      <a href="/dashboard#my-reports" class="cers-sidebar-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        My Submissions
      </a>
    <% } %>
    
    <% if (user.role === 'response_unit') { %>
      <a href="/dashboard#active-incidents" class="cers-sidebar-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
          <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
        </svg>
        Incident Dispatch Log
      </a>
      <a href="/dashboard#notifications" class="cers-sidebar-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        Notification Feed
      </a>
    <% } %>
    
    <% if (user.role === 'admin') { %>
      <a href="/dashboard#incidents-log" class="cers-sidebar-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
        Incident Log (All)
      </a>
      <a href="/dashboard#users-control" class="cers-sidebar-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        Manage User Accounts
      </a>
    <% } %>

    <!-- Sidebar Logout Button -->
    <a href="#" id="cers-btn-logout" class="cers-sidebar-item" style="color: var(--cers-danger); border-top: 1px solid var(--cers-border); padding-top: 0.85rem; margin-top: 0.75rem;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
      Logout
    </a>
  </div>
  
  <div class="mt-auto p-3" style="background-color: var(--cers-bg-subtle); border-radius: var(--cers-radius); font-size: 0.72rem; color: var(--cers-text-muted); border: 1px solid var(--cers-border);">
    <div style="font-weight: 800; color: var(--cers-primary); margin-bottom: 0.35rem; text-transform: uppercase; font-size: 0.68rem; letter-spacing: 0.5px;">Emergency Contacts</div>
    Security Dispatch: <strong>Ext 911</strong><br>
    Campus Medical: <strong>Ext 112</strong><br>
    Fire Marshall: <strong>Ext 119</strong>
  </div>
</aside>
<% } %>
