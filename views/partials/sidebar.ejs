<% if (user) { %>
<aside class="cers-sidebar">
  
  <!-- User Profile Initials Avatar Section -->
  <div style="display: flex; align-items: center; gap: 0.75rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--cers-border); margin-bottom: 1.25rem;">
    <div style="width: 42px; height: 42px; border-radius: 50%; background-color: var(--cers-accent); color: #ffffff; display: flex; justify-content: center; align-items: center; font-weight: 800; font-size: 1.05rem; flex-shrink: 0; text-transform: uppercase;">
      <%= user.name.split(' ').map(n => n[0]).join('').substring(0, 2) %>
    </div>
    <div style="min-width: 0; flex: 1;">
      <div style="font-weight: 700; font-size: 0.88rem; color: var(--cers-text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= user.name %>">
        <%= user.name %>
      </div>
      <div style="font-size: 0.7rem; color: var(--cers-text-muted); text-transform: uppercase; font-weight: 700; margin-top: 0.1rem;">
        <%= user.role === 'response_unit' ? `${user.response_unit_type.toUpperCase()} RESPONDER` : user.role.toUpperCase() %>
      </div>
    </div>
  </div>

  <div style="font-size: 0.75rem; font-weight: 700; color: var(--cers-text-muted); text-transform: uppercase; letter-spacing: 0.5px; padding-left: 0.5rem; margin-bottom: 0.5rem;">
    Navigation Menu
  </div>
  
  <div class="cers-sidebar-menu" style="display: flex; flex-direction: column; gap: 0.35rem;">
    <a href="/dashboard" class="cers-sidebar-item">
      Dashboard
    </a>
    
    <% if (user.role === 'reporter') { %>
      <div class="px-2 py-2 mb-1 mt-1" style="background-color: #fef2f2; border: 1.5px solid #fee2e2; border-radius: var(--cers-radius);">
        <button id="cers-sidebar-emergency-trigger" class="cers-btn cers-btn-danger w-100 py-2" style="font-weight: 800; font-size: 0.8rem;">
          QUICK ALERT
        </button>
        <div id="cers-sidebar-emergency-status" style="font-size: 0.68rem; text-align: center; color: var(--cers-danger); font-weight: 600; margin-top: 0.25rem; height: 15px; overflow: hidden;"></div>
      </div>
      
      <a href="/incidents/report" class="cers-sidebar-item">
        New Report Form
      </a>
      <a href="/dashboard#my-reports" class="cers-sidebar-item">
        My Submissions
      </a>
    <% } %>
    
    <% if (user.role === 'response_unit') { %>
      <a href="/dashboard#active-incidents" class="cers-sidebar-item">
        Incident Dispatch Log
      </a>
      <a href="/dashboard#notifications" class="cers-sidebar-item">
        Notification Feed
      </a>
    <% } %>
    
    <% if (user.role === 'admin') { %>
      <a href="/dashboard#incidents-log" class="cers-sidebar-item">
        Incident Log (All)
      </a>
      <a href="/dashboard#users-control" class="cers-sidebar-item">
        Manage User Accounts
      </a>
    <% } %>

    <!-- Sidebar Logout Button -->
    <a href="#" id="cers-btn-logout" class="cers-sidebar-item" style="color: var(--cers-danger); border-top: 1px solid var(--cers-border); padding-top: 1rem; margin-top: 1rem; display: flex; align-items: center; gap: 0.5rem; font-weight: 700;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
      Logout
    </a>
  </div>
  
  <div class="mt-auto p-3" style="background-color: #f8fafc; border-radius: var(--cers-radius); font-size: 0.75rem; color: var(--cers-text-muted); border: 1.5px solid var(--cers-border);">
    <div style="font-weight: 800; color: var(--cers-text-main); margin-bottom: 0.25rem; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.25px;">Emergency Contacts</div>
    Campus Security: <strong>Ext 911</strong><br>
    Medical Center: <strong>Ext 112</strong><br>
    Fire Station: <strong>Ext 119</strong>
  </div>
</aside>
<% } %>
